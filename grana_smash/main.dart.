import 'package:flutter/material.dart';
import 'package:intl/intl.dart';

void main() {
  runApp(const AssetFlowApp());
}

class Transacao {
  final String id;
  final String titulo;
  final double valor;
  final String categoria;
  final String data;
  final bool isDespesa;

  Transacao({
    required this.id,
    required this.titulo,
    required this.valor,
    required this.categoria,
    required this.data,
    required this.isDespesa,
  });
}

class AssetFlowApp extends StatelessWidget {
  const AssetFlowApp({super.key});
  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: TelaBemVindo(), 
    );
  }
}

class TelaBemVindo extends StatefulWidget {
  const TelaBemVindo({super.key});

  @override
  State<TelaBemVindo> createState() => _TelaBemVindoState();
}

class _TelaBemVindoState extends State<TelaBemVindo> {
  final _nomeController = TextEditingController();
  final _salarioController = TextEditingController();

  void _entrarNoApp() {
    final nome = _nomeController.text.trim();
    final salario = double.tryParse(_salarioController.text.replaceAll(',', '.')) ?? 0.0;

    if (nome.isNotEmpty && salario > 0) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(
          builder: (context) => TelaPrincipal(nomeUsuario: nome, salarioInicial: salario),
        ),
      );
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Por favor, introduza o seu nome e salário inicial.')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF3B333E), 
      body: Center(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(32.0),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Icon(Icons.account_balance_wallet, color: Colors.white, size: 70),
              const SizedBox(height: 15),
              const Text('Asset Flow', style: TextStyle(color: Colors.white, fontSize: 32, fontWeight: FontWeight.bold)),
              const SizedBox(height: 40),
              TextField(
                controller: _nomeController,
                style: const TextStyle(color: Colors.white),
                decoration: InputDecoration(
                  labelText: 'Qual é o seu nome?',
                  labelStyle: const TextStyle(color: Colors.white70),
                  enabledBorder: OutlineInputBorder(borderSide: const BorderSide(color: Colors.white70), borderRadius: BorderRadius.circular(10)),
                  focusedBorder: OutlineInputBorder(borderSide: const BorderSide(color: Colors.white), borderRadius: BorderRadius.circular(10)),
                ),
              ),
              const SizedBox(height: 20),
              TextField(
                controller: _salarioController,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                style: const TextStyle(color: Colors.white),
                decoration: InputDecoration(
                  labelText: 'Qual é o seu salário/saldo atual? (R\$)',
                  labelStyle: const TextStyle(color: Colors.white70),
                  enabledBorder: OutlineInputBorder(borderSide: const BorderSide(color: Colors.white70), borderRadius: BorderRadius.circular(10)),
                  focusedBorder: OutlineInputBorder(borderSide: const BorderSide(color: Colors.white), borderRadius: BorderRadius.circular(10)),
                ),
              ),
              const SizedBox(height: 40),
              SizedBox(
                width: double.infinity,
                height: 50,
                child: ElevatedButton(
                  onPressed: _entrarNoApp,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF536A34), 
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                  ),
                  child: const Text('Acessar', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold)),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class TelaPrincipal extends StatefulWidget {
  final String nomeUsuario;
  final double salarioInicial;

  const TelaPrincipal({super.key, required this.nomeUsuario, required this.salarioInicial});

  @override
  State<TelaPrincipal> createState() => _TelaPrincipalState();
}

class _TelaPrincipalState extends State<TelaPrincipal> {
  final List<Transacao> _allTransacoes = [];
  String _filtroSelecionado = 'Todas'; 

  double get _totalReceitas => _allTransacoes.where((t) => !t.isDespesa).fold(0.0, (sum, item) => sum + item.valor);
  double get _totalDespesas => _allTransacoes.where((t) => t.isDespesa).fold(0.0, (sum, item) => sum + item.valor);
  
  double get _saldoConsolidado => widget.salarioInicial + _totalReceitas - _totalDespesas;

  List<Transacao> get _transacoesFiltradas {
    if (_filtroSelecionado == 'Receitas') {
      return _allTransacoes.where((t) => !t.isDespesa).toList();
    } else if (_filtroSelecionado == 'Despesas') {
      return _allTransacoes.where((t) => t.isDespesa).toList();
    }
    return _allTransacoes;
  }

  void _deletarTransacao(String id) {
    setState(() {
      _allTransacoes.removeWhere((t) => t.id == id);
    });
  }

  void _abrirModalCadastro(bool isDespesa) {
    final tituloController = TextEditingController();
    final valorController = TextEditingController();
    final categoriaController = TextEditingController();

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text(isDespesa ? 'Adicionar Despesa' : 'Adicionar Receita'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(controller: tituloController, decoration: const InputDecoration(labelText: 'Título (Ex: Renda, Comida)')),
            TextField(controller: categoriaController, decoration: const InputDecoration(labelText: 'Categoria (Ex: Fixo, Alimentação)')),
            TextField(
              controller: valorController,
              decoration: const InputDecoration(labelText: 'Valor R\$'),
              keyboardType: const TextInputType.numberWithOptions(decimal: true),
            ),
          ],
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancelar')),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: isDespesa ? const Color(0xFFB8664D) : const Color(0xFF536A34)),
            onPressed: () {
              final valor = double.tryParse(valorController.text.replaceAll(',', '.')) ?? 0.0;
              if (tituloController.text.isNotEmpty && valor > 0 && categoriaController.text.isNotEmpty) {
                setState(() {
                  _allTransacoes.insert(0, Transacao(
                    id: DateTime.now().toString(),
                    titulo: tituloController.text,
                    valor: valor,
                    categoria: categoriaController.text,
                    data: DateFormat("dd 'de' MMM.").format(DateTime.now()),
                    isDespesa: isDespesa,
                  ));
                });
                Navigator.pop(ctx);
              }
            },
            child: const Text('Guardar', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    String headerLabel = 'SALDO CONSOLIDADO';
    double headerValue = _saldoConsolidado;

    if (_filtroSelecionado == 'Receitas') {
      headerLabel = 'RECEITAS TOTAIS';
      headerValue = _totalReceitas;
    } else if (_filtroSelecionado == 'Despesas') {
      headerLabel = 'DESPESAS TOTAIS';
      headerValue = _totalDespesas * -1; 
    }

    return Scaffold(
      backgroundColor: const Color(0xFFF5F5F8), 
      body: Column(
        children: [ // <-- O erro estava algures por aqui, na falta do children!
          Container(
            width: double.infinity,
            padding: const EdgeInsets.only(top: 60, left: 24, right: 24, bottom: 40),
            decoration: const BoxDecoration(
              color: Color(0xFF3B333E),
              borderRadius: BorderRadius.only(bottomLeft: Radius.circular(30), bottomRight: Radius.circular(30)),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Row(
                      children: [
                        const Icon(Icons.wallet, color: Colors.white),
                        const SizedBox(width: 8),
                        Text('Asset Flow (${widget.nomeUsuario})', style: const TextStyle(color: Colors.white, fontSize: 20, fontWeight: FontWeight.bold)),
                      ],
                    ),
                    IconButton(
                      icon: const Icon(Icons.exit_to_app, color: Colors.white70),
                      onPressed: () => Navigator.pushReplacement(context, MaterialPageRoute(builder: (context) => const TelaBemVindo())),
                    )
                  ],
                ),
                const SizedBox(height: 30),
                Text(headerLabel, style: const TextStyle(color: Colors.white70, fontSize: 12, fontWeight: FontWeight.bold)),
                Text('R\$ ${headerValue.toStringAsFixed(2)}', style: const TextStyle(color: Colors.white, fontSize: 34, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
          const SizedBox(height: 20),

          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                ElevatedButton(
                  onPressed: () => _abrirModalCadastro(false),
                  style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF536A34), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10))),
                  child: const Text('Adicionar Receita', style: TextStyle(color: Colors.white)),
                ),
                ElevatedButton(
                  onPressed: () => _abrirModalCadastro(true),
                  style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFFB8664D), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10))),
                  child: const Text('Adicionar Despesa', style: TextStyle(color: Colors.white)),
                ),
              ],
            ),
          ),
          const SizedBox(height: 20),

          Container(
            margin: const EdgeInsets.symmetric(horizontal: 32),
            padding: const EdgeInsets.all(4),
            decoration: BoxDecoration(color: const Color(0xFFDCDCDC), borderRadius: BorderRadius.circular(25)),
            child: Row(
              children: ['Todas', 'Receitas', 'Despesas'].map((tipo) {
                final isSelected = _filtroSelecionado == tipo;
                return Expanded(
                  child: GestureDetector(
                    onTap: () => setState(() => _filtroSelecionado = tipo),
                    child: Container(
                      padding: const EdgeInsets.symmetric(vertical: 8),
                      decoration: BoxDecoration(
                        color: isSelected ? Colors.white : Colors.transparent,
                        borderRadius: BorderRadius.circular(20),
                        boxShadow: isSelected ? [const BoxShadow(color: Colors.black12, blurRadius: 4)] : null,
                      ),
                      child: Text(
                        tipo,
                        textAlign: TextAlign.center,
                        style: TextStyle(fontWeight: FontWeight.bold, color: isSelected ? Colors.black : Colors.black54),
                      ),
                    ),
                  ),
                );
              }).toList(),
            ),
          ),
          const SizedBox(height: 20),

          Expanded(
            child: _transacoesFiltradas.isEmpty
                ? const Center(child: Text('Nenhum registo encontrado.', style: TextStyle(color: Colors.grey, fontSize: 16)))
                : ListView.builder(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    itemCount: _transacoesFiltradas.length,
                    itemBuilder: (ctx, index) {
                      final tr = _transacoesFiltradas[index];
                      return Container(
                        margin: const EdgeInsets.only(bottom: 12),
                        padding: const EdgeInsets.all(14),
                        decoration: BoxDecoration(
                          color: Colors.white,
                          border: Border.all(color: Colors.grey.shade300),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: Row(
                          children: [
                            CircleAvatar(
                              backgroundColor: tr.isDespesa ? const Color(0xFFB8664D) : const Color(0xFF536A34),
                              radius: 16,
                              child: Icon(tr.isDespesa ? Icons.arrow_downward : Icons.arrow_upward, color: Colors.white, size: 16),
                            ),
                            const SizedBox(width: 12),
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(tr.titulo, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
                                  const SizedBox(height: 6),
                                  Row(
                                    children: [
                                      Container(
                                        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 3),
                                        decoration: BoxDecoration(
                                          color: tr.isDespesa ? const Color(0xFFFA7779) : Colors.lightGreen.shade300,
                                          borderRadius: BorderRadius.circular(10),
                                        ),
                                        child: Text(tr.categoria, style: const TextStyle(fontSize: 10, fontWeight: FontWeight.bold, color: Colors.black87)),
                                      ),
                                      const SizedBox(width: 8),
                                      Text(tr.data, style: const TextStyle(fontSize: 11, color: Colors.grey, fontWeight: FontWeight.bold)),
                                    ],
                                  ),
                                ],
                              ),
                            ),
                            Column(
                              crossAxisAlignment: CrossAxisAlignment.end,
                              children: [
                                Text(
                                  '${tr.isDespesa ? '-' : '+'} R\$ ${tr.valor.toStringAsFixed(2)}',
                                  style: TextStyle(
                                    color: tr.isDespesa ? const Color(0xFFFA7779) : const Color(0xFF536A34),
                                    fontWeight: FontWeight.bold,
                                    fontSize: 15,
                                  ),
                                ),
                                IconButton(
                                  icon: const Icon(Icons.delete_outline, color: Colors.redAccent, size: 20),
                                  onPressed: () => _deletarTransacao(tr.id),
                                  constraints: const BoxConstraints(),
                                  padding: const EdgeInsets.only(top: 4),
                                ),
                              ],
                            ),
                          ],
                        ),
                      );
                    },
                  ),
          ),
        ],
      ),
    );
  }
}
